    <TIER LINGUISTIC_TYPE_REF="dependent" PARENT_REF="発話" TIER_ID="共通語訳">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1021" ANNOTATION_REF="a645">
                <ANNOTATION_VALUE>昔　昔ね　この　奈良田に　うんと　腕の　良い　曲げ物師が　いたのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1022" ANNOTATION_REF="a646">
                <ANNOTATION_VALUE>このように　言えばね、そこに　合いの手が　いればね、「マー」って　言う。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1023" ANNOTATION_REF="a647">
                <ANNOTATION_VALUE>その　曲げ物師が　うんと　腕の　良い　曲げ物師が　いたのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1024" ANNOTATION_REF="a648">
                <ANNOTATION_VALUE>そして　夏は　ほら　焼畑を　ここでは　しているので、焼畑を　して　稼がなければならないので、</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1025" ANNOTATION_REF="a649">
                <ANNOTATION_VALUE>冬の　（アイ）　内　その　曲げ物というのは　お鉢とか　蒸篭とか　弁当　曲げ弁当という</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1026" ANNOTATION_REF="a650">
                <ANNOTATION_VALUE>その　ことなんだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1027" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>そして　冬中　それを　曲げ物を　拵えて　早川町を　町を　ずっと　売って　歩いたのだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1028" ANNOTATION_REF="a652">
                <ANNOTATION_VALUE>そして</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1029" ANNOTATION_REF="a653">
                <ANNOTATION_VALUE>今で　言う　都川。保。そこに　あの　いつも　泊まる　宿が　あって</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1030" ANNOTATION_REF="a654">
                <ANNOTATION_VALUE>その　曲げ物師は　吾平という　名前だよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1031" ANNOTATION_REF="a655">
                <ANNOTATION_VALUE>吾平は　いつも　（ミ）　保の　その　決まった　宿に　泊まって</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1032" ANNOTATION_REF="a656">
                <ANNOTATION_VALUE>そして　その　曲物を　持って　早川町を　売って　歩いたのだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1033" ANNOTATION_REF="a657">
                <ANNOTATION_VALUE>それが　その　保の　泊まる　家に　とても　良い　娘が　一人　いたのだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1034" ANNOTATION_REF="a658">
                <ANNOTATION_VALUE>それが　琴路という　名前なのだが</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1035" ANNOTATION_REF="a659">
                <ANNOTATION_VALUE>それは　器量良しの　良い　娘だったのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1036" ANNOTATION_REF="a660">
                <ANNOTATION_VALUE>そうすると　いつの間にか　吾平と　琴路は　男と　女の　仲に　なって</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1037" ANNOTATION_REF="a661">
                <ANNOTATION_VALUE>今度は　離れられない　（ゴ）　具合に　なったのだそうだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1038" ANNOTATION_REF="a662">
                <ANNOTATION_VALUE>それが　奈良田の　吾平は　一人息子なので　ほら</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1039" ANNOTATION_REF="a663">
                <ANNOTATION_VALUE>奈良田の　家を　継がなければならないので　もう</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1040" ANNOTATION_REF="a664">
                <ANNOTATION_VALUE>親類衆が　集まって</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1041" ANNOTATION_REF="a665">
                <ANNOTATION_VALUE>「吾平も　もう　まあ　嫁を　もらう頃だから</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1042" ANNOTATION_REF="a666">
                <ANNOTATION_VALUE>あの　娘が　良いんじゃないだろうか　この　娘が　良いんじゃないだろうか」と　村の　奈良田の　村の</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1043" ANNOTATION_REF="a667">
                <ANNOTATION_VALUE>女の　子たちを　その　選っていて　もう</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1044" ANNOTATION_REF="a668">
                <ANNOTATION_VALUE>「そうだ。あの　娘が　良いよ」ということに　親類衆（ジ）　では　決まって</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1045" ANNOTATION_REF="a669">
                <ANNOTATION_VALUE>「今度　吾平が　来たら　あの　娘と　くっつけなければならない」って　話して　いたのだそうだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1046" ANNOTATION_REF="a670">
                <ANNOTATION_VALUE>その　今度は　吾平は</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1047" ANNOTATION_REF="a671">
                <ANNOTATION_VALUE>冬中　保に　いたのだが</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1048" ANNOTATION_REF="a672">
                <ANNOTATION_VALUE>「今度は　もう　暖かくなりはじめたので</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1049" ANNOTATION_REF="a673">
                <ANNOTATION_VALUE>山仕事を　しなければならないので　私は　奈良田に　帰るよ」と　そう　言ったら</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1050" ANNOTATION_REF="a674">
                <ANNOTATION_VALUE>さあ　琴路は　つらくて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1051" ANNOTATION_REF="a675">
                <ANNOTATION_VALUE>離れられないという騒ぎだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1052" ANNOTATION_REF="a676">
                <ANNOTATION_VALUE>「それが　そうは　言っていられないよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1053" ANNOTATION_REF="a677">
                <ANNOTATION_VALUE>私は　奈良田に　帰らなければ」って　吾平は</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1054" ANNOTATION_REF="a678">
                <ANNOTATION_VALUE>奈良田に　帰って　来たのだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1055" ANNOTATION_REF="a679">
                <ANNOTATION_VALUE>そして　もう　村の人達は　もう　その</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1056" ANNOTATION_REF="a680">
                <ANNOTATION_VALUE>保で　琴路という　娘と　良い　仲というのは　噂が　もう　奈良田にも　来ていて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1057" ANNOTATION_REF="a681">
                <ANNOTATION_VALUE>「本当に　呆れることだ。吾平は　保に　保の　娘に　とられてはならない」と　言っていたのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1058" ANNOTATION_REF="a682">
                <ANNOTATION_VALUE>そして　吾平が　来たので　すぐに　今度は　その　奈良田の　娘を</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1059" ANNOTATION_REF="a683">
                <ANNOTATION_VALUE>「あの　娘を　嫁に　もらえよ　お前は」と</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1060" ANNOTATION_REF="a684">
                <ANNOTATION_VALUE>親類中で　そう　言って　言ったのだそうだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1061" ANNOTATION_REF="a685">
                <ANNOTATION_VALUE>その　吾平も　返事に　困って</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1062" ANNOTATION_REF="a686">
                <ANNOTATION_VALUE>「まあ　少し　考えて」と　やっと　言ったのだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1063" ANNOTATION_REF="a687">
                <ANNOTATION_VALUE>今度は　一方　保の　琴路は　ほら　ここへ　走って来たのだ　奈良田に。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1064" ANNOTATION_REF="a688">
                <ANNOTATION_VALUE>吾平に。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1065" ANNOTATION_REF="a689">
                <ANNOTATION_VALUE>今度は　あれだそうだ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1066" ANNOTATION_REF="a690">
                <ANNOTATION_VALUE>毎日　奈良田に　夜に　なれば　帰って</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1067" ANNOTATION_REF="a691">
                <ANNOTATION_VALUE>あの　五里の　道を。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1068" ANNOTATION_REF="a692">
                <ANNOTATION_VALUE>保の　向いの　今の　車道とは　違うんだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1069" ANNOTATION_REF="a693">
                <ANNOTATION_VALUE>向こう側へ　行って　山を　こう　こう　行って　奈良田に　来るのだそうだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1070" ANNOTATION_REF="a694">
                <ANNOTATION_VALUE>さあ　困って　奈良田の人たちも　（コ）　「今夜も　来るだろうか　あの子が」と言って</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1071" ANNOTATION_REF="a695">
                <ANNOTATION_VALUE>見張りを　していると　本当に　来るのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1072" ANNOTATION_REF="a696">
                <ANNOTATION_VALUE>ここに　ろうそくを　こう　日本　立てて　こう　縛って　火を　つけて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1073" ANNOTATION_REF="a697">
                <ANNOTATION_VALUE>山の　中　その　すごい　形相だったそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1074" ANNOTATION_REF="a698">
                <ANNOTATION_VALUE>そして　今度は　吾平が　困って　毎日　来るので。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1075" ANNOTATION_REF="a699">
                <ANNOTATION_VALUE>「どう　しよう」と　思って　一晩　考えて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1076" ANNOTATION_REF="a700">
                <ANNOTATION_VALUE>今度は　「決心が　ついた」　ということで　吾平はね</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1077" ANNOTATION_REF="a701">
                <ANNOTATION_VALUE>あれだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1078" ANNOTATION_REF="a702">
                <ANNOTATION_VALUE>山に　こう　奈良田に　来る　ところに　丸太橋が　あるのだって　一か所。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1079" ANNOTATION_REF="a703">
                <ANNOTATION_VALUE>そこに　のこぎりを　持って　ある　晩</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1080" ANNOTATION_REF="a704">
                <ANNOTATION_VALUE>あの　登って行って</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1081" ANNOTATION_REF="a705">
                <ANNOTATION_VALUE>そして　こう　三本　丸木橋が　こう　ある　所の　こっち側を</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1082" ANNOTATION_REF="a706">
                <ANNOTATION_VALUE>三分の　一ずつ　三本を　のこぎりで</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1083" ANNOTATION_REF="a707">
                <ANNOTATION_VALUE>切り込んでおいたのだそうだ。さあ　踏めば</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1084" ANNOTATION_REF="a708">
                <ANNOTATION_VALUE>そこが　折れる#{ので}。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1085" ANNOTATION_REF="a709">
                <ANNOTATION_VALUE>さあ　それとは　知らないで　琴路は　その　晩も　その　うれしそうに　来た。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1086" ANNOTATION_REF="a710">
                <ANNOTATION_VALUE>今度は　そこに　こう　渡り込んだら　ぱーっと　折れたんだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1087" ANNOTATION_REF="a711">
                <ANNOTATION_VALUE>真っ逆さまに</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1088" ANNOTATION_REF="a712">
                <ANNOTATION_VALUE>早川の　崖に</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1089" ANNOTATION_REF="a713">
                <ANNOTATION_VALUE>落ちたのだそうだ#{よ}　琴路は。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1090" ANNOTATION_REF="a714">
                <ANNOTATION_VALUE>そして　そこを　のこぎりで　切り込んで　奈良田に　帰って来て</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1091" ANNOTATION_REF="a715">
                <ANNOTATION_VALUE>吾平は</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1092" ANNOTATION_REF="a716">
                <ANNOTATION_VALUE>「こんな　他所の　{咳}　他所の　村とは　一緒に　なっては　まずいような　（キソ）　規則は　おかしいから</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1093" ANNOTATION_REF="a717">
                <ANNOTATION_VALUE>これからは　他所の　者なら　どこの　地の　者でも　良い　仲に　なれば</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1094" ANNOTATION_REF="a718">
                <ANNOTATION_VALUE>一緒に　結ばれる　ことを　私は</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1095" ANNOTATION_REF="a719">
                <ANNOTATION_VALUE>希望する」という　遺言を　書いて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1096" ANNOTATION_REF="a720">
                <ANNOTATION_VALUE>そして　自分は　奈良田の</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1097" ANNOTATION_REF="a721">
                <ANNOTATION_VALUE>昔　あったんだ　「西のはば」って。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1098" ANNOTATION_REF="a722">
                <ANNOTATION_VALUE>こう　ここのあたりが　ここが　西のはばとすれば　ここへ　来ると　とても　怖くて</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1099" ANNOTATION_REF="a723">
                <ANNOTATION_VALUE>よく　親が　私が　小さい　時も</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1100" ANNOTATION_REF="a724">
                <ANNOTATION_VALUE>「西のはばへ　行くんじゃないよ　落ちるから」と　言っていたよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1101" ANNOTATION_REF="a725">
                <ANNOTATION_VALUE>そこへ　来て　真っ逆さまに</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1102" ANNOTATION_REF="a726">
                <ANNOTATION_VALUE>あの　あれだそうだ#{よ}　吾平は　飛び込んで　死んだんだそうだ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1103" ANNOTATION_REF="a727">
                <ANNOTATION_VALUE>そうしたら　奈良田で　飛び込んだ　者と</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1104" ANNOTATION_REF="a728">
                <ANNOTATION_VALUE>保の　崖の　上で　飛び込んだ　琴路と</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1105" ANNOTATION_REF="a729">
                <ANNOTATION_VALUE>同じ　所に　止まって　二人　揃って　こう　止まったのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1106" ANNOTATION_REF="a730">
                <ANNOTATION_VALUE>／／ それで　ほら</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1107" ANNOTATION_REF="a731">
                <ANNOTATION_VALUE>琴路は　あのように　早川の　所だよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1108" ANNOTATION_REF="a732">
                <ANNOTATION_VALUE>吾平は　ここなのだが　一緒に　止まったのだって。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1109" ANNOTATION_REF="a733">
                <ANNOTATION_VALUE>流れて行って　同じ　所#{に}。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1110" ANNOTATION_REF="a734">
                <ANNOTATION_VALUE>すると　本当に　それから　吾平の　書き置きが</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1111" ANNOTATION_REF="a735">
                <ANNOTATION_VALUE>あったので　今度は　村でも　会議を　して　あれだよ　寄り合いを　して</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1112" ANNOTATION_REF="a736">
                <ANNOTATION_VALUE>そして　他所の　者でも　何でも　それからは　一緒に　なれるという　法に　なったのだそうだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1113" ANNOTATION_REF="a737">
                <ANNOTATION_VALUE>それで　今は　奈良田でも　（ドッ）　遠くからも　嫁に　来て　嫁に　他所に　行ったり　しているんだよ。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1114" ANNOTATION_REF="a738">
                <ANNOTATION_VALUE>それで　おしまい。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
